# Vorlage fuer die Edge-Function-Secrets eines Supabase-Projekts.
# Echte Werte in supabase/.env.dev bzw. supabase/.env.prod (beide nicht im Repo),
# einspielen mit:  npm run secrets:dev
#
# WICHTIG: INTERNAL_EMAIL_SECRET muss sich zwischen DEV und PROD unterscheiden.
# Es ist die einzige Absicherung von send-email (JWT-Pruefung dort abgeschaltet).

INTERNAL_EMAIL_SECRET=

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# Basis fuer Links in Bestaetigungs- und Reset-Mails
APP_URL=
APP_BASE_DOMAIN=

# NUR in DEV setzen: leitet jede ausgehende Mail auf diese Adresse um.
# In PROD muss diese Zeile FEHLEN, sonst landen Kundenmails im Testpostfach.
EMAIL_REDIRECT_TO=

# Zahlungen (Geldkette 1.2b). DEV: PAYMENTS_MODE=test und ein sk_test_/rk_test_-Key.
# test verlangt sk_test_/rk_test_, live verlangt sk_live_/rk_live_ — sonst CONFIG_ERROR.
PAYMENTS_MODE=
STRIPE_SECRET_KEY=
# Signing Secret des Snapshot-Webhook-Endpunkts (1.4), whsec_…
STRIPE_WEBHOOK_SECRET=
# Optional, nur während der Rotation: zweites whsec_…, danach wieder leeren.
STRIPE_WEBHOOK_SECRET_2=
# Optional: Signing Secret des Thin-/Schlank-Ziels (v2-Ereignisse).
STRIPE_WEBHOOK_SECRET_THIN=
# Optional: stripe (Standard) oder fake (nur mit PAYMENTS_MODE=test).
PAYMENTS_PROVIDER=

# 2.1b-b B2: Secret für Edge Function dispatch-emails (Cron/pg_net).
# Nur DEV: scripts/dev/email_dispatch_secret.mjs erzeugt es und schreibt es hierhin.
# Danach: npm run secrets:dev. Nie ausgeben, nie committen.
EMAIL_DISPATCH_SECRET=
