# Ziele fuer scripts/db.mjs. Diese Datei ist die Vorlage — echte Werte gehoeren in
# .env.deploy (nicht im Repo). Passwoerter kommen aus dem Passwortmanager.
#
# DB_HOST ist der Pooler-Praefix aus Supabase Dashboard -> Connect -> Session pooler,
# also der Teil vor ".pooler.supabase.com" (z. B. aws-1-eu-central-1).

DEV_REF=
DEV_DB_HOST=
DEV_DB_PASSWORD=

PROD_REF=
PROD_DB_HOST=
PROD_DB_PASSWORD=

# Cloudflare API-Token, ausschliesslich fuer die Zone omlify-dev.de.
# Nur waehrend der Einrichtung noetig — danach in Cloudflare widerrufen.
CF_API_TOKEN=
CF_ZONE=omlify-dev.de
